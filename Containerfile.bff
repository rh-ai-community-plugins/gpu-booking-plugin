# Stage 1: Build Go backend (CGO required for mattn/go-sqlite3)
FROM registry.access.redhat.com/ubi9/go-toolset:1.25 AS backend-builder

USER 0
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY pkg/ pkg/

RUN CGO_ENABLED=1 GOOS=linux go build -o /backend ./cmd/backend/

# Stage 2: Final image
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

LABEL org.opencontainers.image.title="GPU Booking Backend"
LABEL org.opencontainers.image.description="Go API backend for the GPU Booking RHOAI dashboard plugin"

RUN microdnf install -y sqlite-libs && microdnf clean all

WORKDIR /app
COPY --from=backend-builder /backend /app/backend

ENV PORT=3000
ENV DB_PATH=/app/data/bookings.db

RUN mkdir -p /app/data && chown -R 1001:0 /app && chmod -R g=u /app

USER 1001
EXPOSE 3000

CMD ["/app/backend"]
